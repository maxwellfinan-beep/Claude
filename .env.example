# Copy this file to .env and fill in your values
DISCORD_TOKEN=your-bot-token-here

# Optional — defaults shown
DUCK_CHANNEL=duck-hunt        # text channel where ducks spawn
DUCK_SPAWN_MIN=30             # min seconds between duck spawns
DUCK_SPAWN_MAX=180            # max seconds between duck spawns
DB_PATH=scores.db             # SQLite database file path
